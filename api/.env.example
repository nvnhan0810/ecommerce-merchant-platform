HTTP_ADDR=:8080
APP_ENV=production

# CORS origins for the 3 frontends
CORS_WEB=https://ecomerce.nvnhan0810.com
CORS_MERCHANT=https://ecomerce-merchant.nvnhan0810.com
CORS_ADMIN=https://ecomerce-admin.nvnhan0810.com

# PostgreSQL — điền detail thật rồi copy thành api/.env
DB_HOST=192.168.100.28
DB_PORT=5432
DB_DATABASE=nvnhan0810_ecomerce
DB_USERNAME=nvnhan0810
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=disable
# Optional override (nếu set thì bỏ qua DB_* riêng lẻ)
# DATABASE_URL=postgres://nvnhan0810:CHANGE_ME@192.168.100.28:5432/nvnhan0810_ecomerce?sslmode=disable

# Auto-migrate schema + seed demo rows khi bảng trống
DB_AUTO_MIGRATE=true
DB_SEED=true
