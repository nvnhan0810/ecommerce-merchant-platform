# SeaweedFS S3 (in-cluster). Real keys belong in .env only (gitignored).
S3_ENDPOINT=http://seaweedfs-s3.seaweedfs.svc.cluster.local:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=ecomerce-nvnhan0810-com
S3_USE_PATH_STYLE=true
# Public API origin used to build product image_url (media proxy)
PUBLIC_API_BASE_URL=https://ecomerce-api.nvnhan0810.com
